{
  "expo": {
    "name": "SomeDaisy",
    "slug": "somedaisy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/square/somedaisy-icon-square-1024.png",
    "scheme": "somedaisy",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icon/square/somedaisy-icon-square-1024.png"
    },
    "android": {
      "package": "com.somedaisy.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F6F0FB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "somedaisy.com",
              "pathPrefix": "/join/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icon/rounded/somedaisy-icon-512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6D2FC4",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8A4BE6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "react-native-nitro-google-signin"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6c6698f7-59b3-4a02-9fdd-b38a6eb4235d"
      }
    },
    "owner": "somedaisy"
  }
}
