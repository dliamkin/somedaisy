# Copy this file to .env and fill in both values from your Supabase project's API settings.
# Both are public values. Never put the secret (service role) key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Optional: the Google OAuth client ID (Web application), for "Continue with Google" on the website.
# Also a public value. The client secret goes only into the Supabase dashboard.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
